/**
 * @fileOverview Firestore Security Rules for Malpe Meen Pvt Ltd App
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.phone_number == '+919892334681';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && exists(/databases/$(database)/documents/sellers/$(userId));
    }

    // Global Admin Rule
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    match /sellers/{sellerId} {
      allow get: if isOwner(sellerId);
      allow list: if false;
      allow create: if isOwner(sellerId) && request.resource.data.id == sellerId;
      allow update: if isOwner(sellerId);
      allow delete: if isExistingOwner(sellerId);
    }

    match /buyers/{buyerId} {
      allow get: if isOwner(buyerId);
      allow list: if false;
      allow create: if isOwner(buyerId) && request.resource.data.id == buyerId;
      allow update: if isOwner(buyerId);
      allow delete: if isExistingOwner(buyerId);
    }

    match /fishListings/{fishListingId} {
      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.sellerId == request.auth.uid || isAdmin());
    }
  }
}
